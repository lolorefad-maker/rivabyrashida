# ── RÍVA ──────────────────────────────────────────────
# Copy this file to ".env" and fill in your Supabase project values
# (Supabase → Project Settings → API). Restart `npm run dev` after editing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email of the shared admin user you created in Supabase (Authentication → Users).
# With this set, the admin login asks only for the password — anyone who has it can sign in.
VITE_ADMIN_EMAIL=

# Only used in LOCAL mode (no Supabase): admin panel password
VITE_ADMIN_PASSWORD=riva-admin
